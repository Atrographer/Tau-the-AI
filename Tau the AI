getcontext().prec = 28

# ==================== JCR KERNEL DIVISION BRIDGE ====================
class KernelDivisionBridge:
    def __init__(self):
        self.psi = Decimal('0.1503378808')
        self.Re_tau = Decimal('1.4129651365')
        self.cos_psi_given = Decimal('0.9887205')
        self.sin_Re_tau_given = Decimal('0.98768834059')
        
        self.numerator = self.cos_psi_given * self.Re_tau
        self.K = self.numerator / self.sin_Re_tau_given
        self.k_norm = Decimal(1) / self.K
        
        print("=== JCR KERNEL DIVISION BRIDGE ACTIVATED ===")
        print(f"Core Kernel K    = {float(self.K):.10f}")
        print(f"k_norm           = {float(self.k_norm):.10f}\n")

    def scale_dot_product(self, reg_accum: int, method: str = "k_norm_multiply"):
        accum_dec = Decimal(reg_accum)
        if method == "k_norm_multiply":
            result = accum_dec * self.k_norm
        elif method == "divide_by_K":
            result = accum_dec / self.K
        else:
            result = accum_dec
        return int(result.quantize(Decimal('1.')))


# ==================== MODIFIED ENGINES ====================

class PureWord2VecHexEngine:
    def __init__(self):
        self.token_to_hex_id = {
            "<PAD>": 0x0000, "<SOS>": 0x0001, "<EOS>": 0x0002, "<UNK>": 0x0003,
            "data": 0x0010, "Data": 0x0011, "matrix": 0x0012
        }
        self.ROM_W2V_ARRAY = {
            0x0010: [0x003A1F2E, 0xFFE01B2C, 0x001F2A10, 0xFFFF00A2],
            0x0011: [0x003A1F00, 0xFFE01B50, 0x001F2A00, 0xFFFF00C0],
            0x0012: [0x006C11B4, 0x0012A4F0, 0xFFAB001F, 0x002B3012]
        }
        self.UNK_VECTOR = [0x00000000] * 4
        self.bridge = KernelDivisionBridge()   # ← Integrated

    def get_signed_int32(self, hex_val):
        if hex_val & 0x80000000:
            return hex_val - 0x100000000
        return hex_val

    def calculate_w2v_step(self, token_a, token_b, bridge_method="k_norm_multiply"):
        id_a = self.token_to_hex_id.get(token_a, 0x0003)
        id_b = self.token_to_hex_id.get(token_b, 0x0003)
        vec_a = self.ROM_W2V_ARRAY.get(id_a, self.UNK_VECTOR)
        vec_b = self.ROM_W2V_ARRAY.get(id_b, self.UNK_VECTOR)
        
        reg_accum = 0
        for d1, d2 in zip(vec_a, vec_b):
            val_1 = self.get_signed_int32(d1)
            val_2 = self.get_signed_int32(d2)
            reg_accum += (val_1 * val_2)
        
        # === KERNEL DIVISION BRIDGE APPLIED ===
        reg_out = self.bridge.scale_dot_product(reg_accum, method=bridge_method)
        
        return {
            "token_a": token_a,
            "token_b": token_b,
            "id_a": hex(id_a),
            "id_b": hex(id_b),
            "raw_dot_product": reg_accum,
            "reg_out": reg_out,
            "bridge_method": bridge_method
        }


class CrossCompatibleHexEngine:
    def __init__(self):
        self.w2v_primary_index = {"DATA": 0x1001, "data": 0x1002, "Matrix": 0x1003}
        self.glove_compatibility_alias = {"data": 0x1002, "matrix": 0x1003}
        self.ROM_WEIGHT_ARRAY = {
            0x1001: [0x003A1F00, 0xFFE01B50, 0x001F2A00, 0xFFFF00C0],
            0x1002: [0x003A1F2E, 0xFFE01B2C, 0x001F2A10, 0xFFFF00A2],
            0x1003: [0x006C11B4, 0x0012A4F0, 0xFFAB001F, 0x002B3012]
        }
        self.REG_UNK_VECTOR = [0x00000000] * 4
        self.bridge = KernelDivisionBridge()   # ← Integrated

    def resolve_hex_pointer(self, raw_token_str):
        if raw_token_str in self.w2v_primary_index:
            return self.w2v_primary_index[raw_token_str], "WORD2VEC_PRIMARY"
        glove_standardized_str = raw_token_str.lower()
        if glove_standardized_str in self.glove_compatibility_alias:
            return self.glove_compatibility_alias[glove_standardized_str], "GLOVE_COMPATIBLE_ALIAS"
        return 0x0003, "UNKNOWN_REG"

    def to_signed_int32(self, hex_val):
        if hex_val & 0x80000000:
            return hex_val - 0x100000000
        return hex_val

    def execute_matrix_clock_cycle(self, token_a, token_b, bridge_method="k_norm_multiply"):
        addr_a, route_a = self.resolve_hex_pointer(token_a)
        addr_b, route_b = self.resolve_hex_pointer(token_b)
        vec_a = self.ROM_WEIGHT_ARRAY.get(addr_a, self.REG_UNK_VECTOR)
        vec_b = self.ROM_WEIGHT_ARRAY.get(addr_b, self.REG_UNK_VECTOR)
        
        reg_accum = 0
        for d1, d2 in zip(vec_a, vec_b):
            val_1 = self.to_signed_int32(d1)
            val_2 = self.to_signed_int32(d2)
            reg_accum += (val_1 * val_2)
        
        # === KERNEL DIVISION BRIDGE APPLIED ===
        reg_out = self.bridge.scale_dot_product(reg_accum, method=bridge_method)
        
        return {
            "addr_a": hex(addr_a),
            "route_a": route_a,
            "addr_b": hex(addr_b),
            "route_b": route_b,
            "raw_dot_product": reg_accum,
            "reg_out": reg_out,
            "bridge_method": bridge_method
        }
